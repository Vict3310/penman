# ─────────────────────────────────────────────────────────────
# Penman Empire — environment variables
# Copy to .env.local and fill with your own Supabase project values.
# NEVER commit .env.local. NEVER prefix a secret with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# Public Supabase project URL (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=

# Public anon / publishable key (safe for the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service-role key. Required for trusted server operations
# (public enquiry inserts, admin reads of enquiry tables).
# NEVER expose this to the browser. Server actions and route handlers only.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string used by the application's own authentication
# layer (users, sessions, password resets). It can point at the same Postgres
# database that Supabase exposes, or at a Neon database — the same code works
# against either. Authentication talks to Postgres directly rather than through
# PostgREST, because account creation and password changes need real
# transactions, which the REST API does not provide.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ── Session configuration (all optional) ────────────────────────────────
# Session lifetime in days. Clamped to 1–90. Default: 7.
# AUTH_SESSION_TTL_DAYS=7
#
# Force the Secure flag on the session cookie. Unset, it follows NODE_ENV:
# Secure in production, relaxed on localhost so `npm run dev` works over http.
# AUTH_COOKIE_SECURE=true

# ── Database TLS (only needed if the defaults do not fit) ───────────────
# Decided by the TARGET host, never by NODE_ENV: plaintext only for localhost,
# always encrypted for anything remote. Running `npm run dev` against a hosted
# database therefore gets TLS.
#
# The peer certificate is NOT verified by default, because Supabase's pooler
# serves a chain Node cannot build to a trusted root ("self-signed certificate
# in certificate chain"). Switch verification on when your provider's chain does
# resolve — it is the stronger setting:
# DATABASE_SSL_VERIFY=true
#
# Set to "disable" to turn TLS off entirely (local/private only), or "require"
# to force TLS on for a localhost target.
# DATABASE_SSL=require
#
# A "?sslmode=" in DATABASE_URL takes precedence. Note that pg reads
# "sslmode=require" as verify-full, so it turns verification ON rather than
# merely asking for encryption.

# ── Removed: third-party identity providers ──────────────────────────────
# BETTER_AUTH_SECRET, AUTH_SECRET, BETTER_AUTH_API_KEY, NEXT_PUBLIC_CLERK_*,
# CLERK_* and ENABLE_LOCAL_CLERK are no longer read by anything. Authentication
# and sessions are owned by this application (see src/lib/auth/). If any of them
# are still set in a deployment, delete them — a lingering value implies a
# provider that is no longer in the path.

# Comma-separated default administrator email address(es).
#
# This no longer grants access on its own. Whether someone may open /admin is
# decided by profiles.role = 'admin' in the database, re-read on every request.
# The value here is only a convenience default for the one-time bootstrap:
#
#   npm run create-admin -- --email you@penmanempire.com
#
ADMIN_EMAIL_ALLOWLIST=admin@yourdomain.com

# Optional: site URL used for canonical URLs, sitemap and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Demonstration data (optional, development only) ──────────────────
# Shows clearly-labelled [DEMO] listings when no database is connected, so
# the design can be reviewed before Supabase is set up.
#
# It is automatic in `npm run dev`. In a production build it must be opted
# into explicitly, and it is ignored entirely once Supabase is configured.
# Leave this unset (or false) for a real deployment.
# DEMO_DATA=true
